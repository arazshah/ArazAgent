# Bootstrap configuration (app/bootstrap.py) — environment only, read once at
# startup, never editable from the admin UI. Everything else (Bale token,
# AvalAI key, admin password, etc.) is configured at runtime from the admin
# UI and stored in the app_settings table — do not put it here.

# Postgres connection string.
DATABASE_URL=postgresql://araz:changeme@db:5432/araz_agent

# Fernet key encrypting every secret stored in app_settings. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing this key makes every stored secret permanently unrecoverable.
SECRET_ENCRYPTION_KEY=changeme-generate-a-real-fernet-key

# Signs admin session cookies. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=changeme-at-least-32-characters-long

# Optional: argon2 hash of the admin password, as a bootstrap fallback if the
# app_settings row is missing. Prefer scripts/set_admin_password.py, which
# writes directly to the database.
ADMIN_PASSWORD_HASH=

# Directory where voice note audio is stored permanently.
AUDIO_DIR=/app/data/audio

# IANA timezone for calendar-day boundaries (e.g. /today).
TZ=Asia/Tehran

LOG_LEVEL=INFO

# Path the admin UI is mounted at. Obscurity only, NOT a security boundary.
ADMIN_PATH=/admin

# Trust X-Forwarded-* headers for client IP (needed behind Coolify's proxy).
TRUST_PROXY_HEADERS=true
